# ==============================================================================
# Environment Configuration
# ==============================================================================
# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cctv_attendance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cctv_attendance
POSTGRES_PORT=5432

# Redis Configuration (Used for live dedup & frame queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=college_hackathon_super_secret_key_change_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Face Recognition & Attendance Thresholds
# ArcFace cosine similarity threshold:
# Matches with cosine similarity >= CONFIRMED_THRESHOLD (e.g. 0.68) are 'confirmed'.
# Matches between NEEDS_REVIEW_THRESHOLD and CONFIRMED_THRESHOLD (e.g. 0.50 to 0.68) are 'needs_review'.
# Below 0.50 is considered unknown / unmarked.
CONFIRMED_THRESHOLD=0.68
NEEDS_REVIEW_THRESHOLD=0.50

# Anti-Spoofing Threshold (MiniFASNet prediction score >= 0.70 considered real face)
SPOOF_CONFIDENCE_THRESHOLD=0.70
